<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skynet - Your Ultimate Digital Gateway</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            text-align: center;
            padding: 20px;
        }

        /* ===== TOP SUMMARY TABLE ===== */
        .top-summary {
            width: 100%;
            max-width: 1200px;
            margin-bottom: 40px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            overflow-x: auto;
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
        }

        .top-summary table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
            min-width: 800px;
        }

        .top-summary th {
            background: rgba(0, 210, 255, 0.15);
            color: #00d2ff;
            padding: 12px 10px;
            text-align: left;
            font-weight: 600;
            letter-spacing: 0.5px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .top-summary td {
            padding: 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            color: #d0d0e0;
        }

        .top-summary tr:last-child td {
            border-bottom: none;
        }

        .top-summary tr:hover td {
            background: rgba(255, 255, 255, 0.03);
        }

        .color-dot {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-right: 6px;
            vertical-align: middle;
        }

        /* Existing Colors */
        .dot-blue { background: #0066ff; }
        .dot-cyan { background: #00d2ff; }
        .dot-orange { background: #ff6a00; }
        .dot-green { background: #38ef7d; }
        .dot-purple { background: #8e2de2; }
        .dot-yellow { background: #ffd200; }
        .dot-teal { background: #20b2aa; }
        .dot-red { background: #e53935; }
        .dot-pink { background: #d81b60; }
        .dot-lime { background: #aeea00; }
        .dot-indigo { background: #3949ab; }
        /* New Color */
        .dot-brown { background: #8d6e63; }

        /* ===== LOGO & MAIN BUTTONS ===== */
        .logo {
            font-size: 4rem;
            font-weight: 800;
            letter-spacing: 3px;
            background: linear-gradient(to right, #00d2ff, #928dab);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
            text-shadow: 0 0 30px rgba(0, 210, 255, 0.3);
        }

        .tagline {
            font-size: 1.1rem;
            color: #b8b8d1;
            margin-bottom: 50px;
            font-weight: 300;
            letter-spacing: 1px;
        }

        .button-container {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
            max-width: 1200px;
        }

        .btn {
            display: inline-block;
            padding: 16px 32px;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            border-radius: 50px;
            transition: all 0.3s ease;
            cursor: pointer;
            border: none;
            letter-spacing: 0.5px;
        }

        /* Existing Button Styles */
        .btn-primary { background: linear-gradient(135deg, #00d2ff, #0066ff); color: #fff; box-shadow: 0 8px 25px rgba(0, 210, 255, 0.4); }
        .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(0, 210, 255, 0.6); background: linear-gradient(135deg, #00e0ff, #0077ff); }

        .btn-secondary { background: transparent; color: #00d2ff; border: 2px solid #00d2ff; }
        .btn-secondary:hover { background: rgba(0, 210, 255, 0.1); transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0, 210, 255, 0.2); }

        .btn-apk { background: linear-gradient(135deg, #ff6a00, #ee0979); color: #fff; box-shadow: 0 8px 25px rgba(255, 106, 0, 0.4); }
        .btn-apk:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(255, 106, 0, 0.6); background: linear-gradient(135deg, #ff7b1a, #ff1a8c); }

        .btn-library { background: linear-gradient(135deg, #11998e, #38ef7d); color: #fff; box-shadow: 0 8px 25px rgba(56, 239, 125, 0.4); }
        .btn-library:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(56, 239, 125, 0.6); background: linear-gradient(135deg, #14b8a6, #4ade80); }

        .btn-file { background: linear-gradient(135deg, #8e2de2, #4a00e0); color: #fff; box-shadow: 0 8px 25px rgba(142, 45, 226, 0.4); }
        .btn-file:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(142, 45, 226, 0.6); background: linear-gradient(135deg, #a03ff5, #5a1aff); }

        .btn-ai { background: linear-gradient(135deg, #f7971e, #ffd200); color: #1a1a2e; box-shadow: 0 8px 25px rgba(247, 151, 30, 0.4); }
        .btn-ai:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(247, 151, 30, 0.6); background: linear-gradient(135deg, #ffa733, #ffdd33); }

        .btn-api { background: linear-gradient(135deg, #20b2aa, #008b8b); color: #fff; box-shadow: 0 8px 25px rgba(32, 178, 170, 0.4); }
        .btn-api:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(32, 178, 170, 0.6); background: linear-gradient(135deg, #2cc9c0, #00a0a0); }

        .btn-darkgpt { background: linear-gradient(135deg, #e53935, #b71c1c); color: #fff; box-shadow: 0 8px 25px rgba(229, 57, 53, 0.4); }
        .btn-darkgpt:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(229, 57, 53, 0.6); background: linear-gradient(135deg, #ff5252, #c62828); }

        .btn-sim { background: linear-gradient(135deg, #d81b60, #880e4f); color: #fff; box-shadow: 0 8px 25px rgba(216, 27, 96, 0.4); }
        .btn-sim:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(216, 27, 96, 0.6); background: linear-gradient(135deg, #f06292, #ad1457); }

        .btn-wifi { background: linear-gradient(135deg, #aeea00, #64dd17); color: #1a1a2e; box-shadow: 0 8px 25px rgba(174, 234, 0, 0.4); }
        .btn-wifi:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(174, 234, 0, 0.6); background: linear-gradient(135deg, #c6ff00, #76ff03); }

        .btn-course { background: linear-gradient(135deg, #3949ab, #1a237e); color: #fff; box-shadow: 0 8px 25px rgba(57, 73, 171, 0.4); }
        .btn-course:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(57, 73, 171, 0.6); background: linear-gradient(135deg, #5c6bc0, #283593); }

        /* Button 12: AglaSem (New) */
        .btn-aglasem {
            background: linear-gradient(135deg, #8d6e63, #5d4037);
            color: #ffffff;
            box-shadow: 0 8px 25px rgba(141, 110, 99, 0.4);
        }
        .btn-aglasem:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(141, 110, 99, 0.6);
            background: linear-gradient(135deg, #a1887f, #6d4c41);
        }

        .footer {
            margin-top: 80px;
            font-size: 0.85rem;
            color: #6c6c8a;
        }

        @media (max-width: 700px) {
            .logo { font-size: 2.8rem; }
            .tagline { font-size: 0.95rem; }
            .btn { padding: 14px 25px; font-size: 0.9rem; width: 100%; }
        }
    </style>
</head>
