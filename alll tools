                </tr>
            </tbody>
        </table>
    </div>

    <!-- ===== MAIN LOGO & BUTTONS ===== -->
    <div class="logo">SKYNET</div>
    <p class="tagline">Your Gateway to Tools, Apps, Ebooks, Files, AI & APIs</p>

    <div class="button-container">

        <a href="https://anuprint.com/#services" class="btn btn-primary" target="_blank">
            🚀 All Tools (Services)
        </a>

        <a href="https://anuprint.com/free-tools/" class="btn btn-secondary" target="_blank">
            🛠️ Free Tools
        </a>

        <a href="https://apkguy.io/" class="btn btn-apk" target="_blank">
            📱 Download APK Apps
        </a>

        <a href="https://welib-public.org/" class="btn btn-library" target="_blank">
