if(id==='random'){by('randMake').onclick=()=>{let min=Math.ceil(+by('randMin').value),max=Math.floor(+by('randMax').value),n=Math.max(1,Math.min(100,+by('randCount').value||1));if(!Number.isSafeInteger(min)||!Number.isSafeInteger(max)||max<min){by('randOut').textContent='Enter valid integer range.';return;}const a=[];for(let i=0;i<n;i++)a.push(Math.floor(Math.random()*(max-min+1))+min);by('randOut').textContent=a.join('\n');};by('randCopy').onclick=()=>copyText(by('randOut').textContent);by('randMake').click();}
if(id==='color'){const hex=by('colorHex'),pick=by('colorPick');function setHex(v){if(!/^#?[0-9a-f]{6}$/i.test(v))return;v=v.startsWith('#')?v:'#'+v;const n=parseInt(v.slice(1),16),r=n>>16&255,g=n>>8&255,b=n&255;hex.value=v.toLowerCase();pick.value=v;by('colorR').value=r;by('colorG').value=g;by('colorB').value=b;by('colorSwatch').style.background=v;}pick.oninput=()=>setHex(pick.value);hex.onchange=()=>setHex(hex.value);['colorR','colorG','colorB'].forEach(()=>{});['colorR','colorG','colorB'].forEach(x=>by(x).oninput=()=>{const r=+by('colorR').value,g=+by('colorG').value,b=+by('colorB').value;setHex('#'+[r,g,b].map(v=>Math.max(0,Math.min(255,v)).toString(16).padStart(2,'0')).join(''));});by('colorCopy').onclick=()=>copyText(hex.value);setHex('#1e5a4a');}
if(id==='gradient'){const update=()=>{const a=by('grad1').value,b=by('grad2').value,ang=Math.max(0,Math.min(360,+by('gradAngle').value||0)),css=by('gradType').value==='linear'?`linear-gradient(${ang}deg, ${a}, ${b})`:`radial-gradient(circle, ${a}, ${b})`;by('gradPreview').style.background=css;by('gradOut').textContent=`background: ${css};`;};['grad1','grad2','gradAngle','gradType'].forEach(x=>by(x).addEventListener('input',update));by('gradCopy').onclick=()=>copyText(by('gradOut').textContent);update();}
if(id==='invoice'){by('invDate').value=new Date().toISOString().slice(0,10);function build(){const rows=by('invItems').value.split(/\r?\n/).filter(Boolean).map(line=>{const p=line.split('|').map(x=>x.trim()),q=Number(p[1]),rate=Number(p[2]);if(!p[0]||!Number.isFinite(q)||!Number.isFinite(rate)||q<0||rate<0)throw Error('Each line should be Description | Quantity | Rate');return {d:p[0],q,r:rate,total:q*rate};});const sub=rows.reduce((s,r)=>s+r.total,0),tax=sub*Math.max(0,+by('invGst').value||0)/100,total=sub+tax;return {rows,sub,tax,total};}function make(){try{const d=build();by('invOut').textContent=`${by('invSeller').value||'Seller'}\nInvoice: ${by('invNo').value}  Date: ${by('invDate').value}\nBill to: ${by('invBuyer').value||'Customer'}\n\n`+d.rows.map(r=>`${r.d} | Qty ${r.q} | ₹${r.r.toFixed(2)} | ₹${r.total.toFixed(2)}`).join('\n')+`\n\nSubtotal: ₹${d.sub.toFixed(2)}\nGST: ₹${d.tax.toFixed(2)}\nTOTAL: ₹${d.total.toFixed(2)}`;return d;}catch(e){by('invOut').textContent=e.message;return null;}}by('invPreview').onclick=make;by('invPrint').onclick=()=>{const d=make();if(!d)return;const w=window.open('','_blank');if(!w)return toast('Allow pop-ups');const rows=d.rows.map(r=>`<tr><td>${esc(r.d)}</td><td>${r.q}</td><td>₹${r.r.toFixed(2)}</td><td>₹${r.total.toFixed(2)}</td></tr>`).join('');w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Invoice ${esc(by('invNo').value)}</title><style>body{font:14px Arial;margin:35px;color:#222}h1{color:#183e32}table{width:100%;border-collapse:collapse;margin-top:30px}td,th{padding:10px;border-bottom:1px solid #ddd;text-align:left}.tot{text-align:right;margin-top:20px;line-height:2}</style></head><body><h1>INVOICE</h1><b>${esc(by('invSeller').value)}</b><p>Invoice: ${esc(by('invNo').value)} | Date: ${esc(by('invDate').value)}</p><p>Bill to: ${esc(by('invBuyer').value)}</p><table><thead><tr><th>Description</th><th>Qty</th><th>Rate</th><th>Amount</th></tr></thead><tbody>${rows}</tbody></table><div class="tot">Subtotal: ₹${d.sub.toFixed(2)}<br>GST: ₹${d.tax.toFixed(2)}<br><b>Total: ₹${d.total.toFixed(2)}</b></div><script>window.onload=()=>setTimeout(()=>window.print(),300)<\/script></body></html>`);w.document.close();};}
if(id==='signature'){function make(){const v={name:by('sigName').value,role:by('sigRole').value,company:by('sigCompany').value,email:by('sigEmail').value,phone:by('sigPhone').value,web:by('sigWeb').value};const line=[v.name,v.role,v.company].filter(Boolean).join(' · '),contact=[v.email,v.phone,v.web].filter(Boolean).join(' | ');const text=[line,contact].filter(Boolean).join('\n');by('sigOut').textContent=text||'Enter your details.';return text;}by('sigMake').onclick=make;by('sigCopy').onclick=()=>copyText(make());}
if(id==='pomodoro'){let remaining=25*60,mode='work',running=false;const render=()=>{by('pomoDisplay').textContent=String(Math.floor(remaining/60)).padStart(2,'0')+':'+String(remaining%60).padStart(2,'0');by('pomoLabel').textContent=mode==='work'?'Focus session':'Break session';};const reset=()=>{running=false;remaining=(mode==='work'?+by('pomoWork').value:+by('pomoBreak').value)*60;render();};by('pomoStart').onclick=()=>{if(running)return;running=true;pomodoroInterval=setInterval(()=>{remaining--;render();if(remaining<=0){clearInterval(pomodoroInterval);pomodoroInterval=null;running=false;toast(mode==='work'?'Focus complete — take a break!':'Break complete — back to focus!');mode=mode==='work'?'break':'work';reset();}},1000);};by('pomoPause').onclick=()=>{running=false;if(pomodoroInterval)clearInterval(pomodoroInterval);pomodoroInterval=null;};by('pomoReset').onclick=()=>{if(pomodoroInterval)clearInterval(pomodoroInterval);pomodoroInterval=null;reset();};by('pomoNext').onclick=()=>{if(pomodoroInterval)clearInterval(pomodoroInterval);pomodoroInterval=null;mode=mode==='work'?'break':'work';reset();};['pomoWork','pomoBreak'].forEach(x=>by(x).onchange=()=>{if(!running)reset();});render();}
}
function parseCSV(text){const rows=[];let row=[],field='',q=false;for(let i=0;i<text.length;i++){const c=text[i];if(q){if(c==='"'&&text[i+1]==='"'){field+='"';i++;}else if(c==='"')q=false;else field+=c;}else{if(c==='"')q=true;else if(c===','){row.push(field);field='';}else if(c==='\n'){row.push(field.replace(/\r$/,''));rows.push(row);row=[];field='';}else field+=c;}}if(q)throw Error('Unclosed quote.');if(field.length||row.length){row.push(field.replace(/\r$/,''));rows.push(row);}return rows;}
function readDataURL(file){return new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=()=>reject(r.error);r.readAsDataURL(file);});}

// Local request note; no network submission.
(function(){const theme=document.getElementById("themeSelect");if(theme){const apply=()=>{const v=theme.value;document.body.dataset.theme=v==="system"?(window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"):v;};theme.addEventListener("change",apply);apply();}const name=document.getElementById("reqName"),desc=document.getElementById("reqDesc");function value(){return `SKYNET TOOL REQUEST\nTool: ${name.value.trim()}\nDescription: ${desc.value.trim()}\nDate: ${new Date().toLocaleDateString()}`;}const dl=document.getElementById("downloadRequest"),cp=document.getElementById("copyRequest");if(dl)dl.onclick=()=>{const blob=new Blob([value()],{type:"text/plain"}),a=document.createElement("a"),u=URL.createObjectURL(blob);a.href=u;a.download="skynet-tool-request.txt";a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);toast("Request note downloaded");};if(cp)cp.onclick=()=>copyText(value());document.querySelectorAll("[data-feature]").forEach(a=>a.addEventListener("click",()=>{const t=tools.find(x=>x.id===a.dataset.feature);if(t)openTool(t.id);}));})();
</script></body></html>
