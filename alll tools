function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.style.opacity='1';clearTimeout(toast._timer);toast._timer=setTimeout(()=>t.style.opacity='0',1900);}
function renderFilters(){filters.innerHTML=cats.map(c=>`<button class="filter ${c===activeCat?'active':''}" data-cat="${esc(c)}">${esc(c)}</button>`).join('');filters.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{activeCat=b.dataset.cat;renderFilters();renderGrid();}));}
function renderGrid(){
 const q=search.value.trim().toLowerCase();
 const found=tools.filter(t=>(activeCat==='All Tools'||(activeCat==='Favorites'?favorites.has(t.id):t.cat===activeCat))&&(!q||(t.name+' '+t.cat+' '+t.desc).toLowerCase().includes(q)));
 const localCount=found.filter(t=>!!t.localId).length;
 const countEl=document.getElementById('toolCount'); if(countEl) countEl.textContent=`Showing ${found.length} tools · ${localCount} built in locally · ${found.length-localCount} open from provider`;
 grid.innerHTML=found.length?found.map(t=>{const local=!!t.localId;return `<article class="toolCard"><div class="cardTop"><span class="toolIcon">${t.icon}</span><button class="fav ${favorites.has(t.id)?'on':''}" data-fav="${t.id}" aria-label="Toggle favorite">${favorites.has(t.id)?'♥':'♡'}</button></div><h3>${esc(t.name)}</h3><p>${esc(t.desc)}</p><div class="cardBottom"><span class="tag">${esc(t.cat)}</span><span class="tag ${local?'localTag':'remoteTag'}">${local?'On this device':(t.href?'Provider link':'Local')}</span></div><div class="cardBottom"><button class="openTool" data-open="${t.id}">${local?'Use tool':'Open tool'} ↗</button></div></article>`;}).join(''):'<div class="empty">No tools found. Try another search or category.</div>';
 grid.querySelectorAll('[data-open]').forEach(b=>b.addEventListener('click',()=>openTool(b.dataset.open)));
 grid.querySelectorAll('[data-fav]').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.fav;favorites.has(id)?favorites.delete(id):favorites.add(id);renderGrid();}));
}
search.addEventListener('input',renderGrid);renderFilters();renderGrid();const heroCount=document.getElementById('heroToolCount');if(heroCount)heroCount.textContent=tools.length;
const modal=document.getElementById('toolModal'), body=document.getElementById('toolBody');
document.getElementById('closeModal').addEventListener('click',closeTool);modal.addEventListener('click',e=>{if(e.target===modal)closeTool();});
function closeTool(){if(currentCleanup){try{currentCleanup()}catch(e){}currentCleanup=null;}if(pomodoroInterval){clearInterval(pomodoroInterval);pomodoroInterval=null;}if(modal.open)modal.close();body.innerHTML='';}
function openTool(id){
 const t=tools.find(x=>x.id===id); if(!t)return;
 if(currentCleanup){try{currentCleanup()}catch(e){}currentCleanup=null;}
 if(pomodoroInterval){clearInterval(pomodoroInterval);pomodoroInterval=null;}
 const localId=t.localId||id, isLocal=!!templates[localId];
 document.getElementById('modalTitle').textContent=t.icon+'  '+t.name;
 document.getElementById('modalDesc').textContent=isLocal?'Runs locally in this browser':'External provider · review privacy before submitting data';
 body.innerHTML=isLocal?templates[localId]:externalPanel(t);
 modal.showModal();
 if(isLocal) bindTool(localId); else bindExternalPanel(t);
}
